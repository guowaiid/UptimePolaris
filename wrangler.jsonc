{
  "name": "uptimepolaris",
  "main": "backends/worker/src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "exports": { "SetupConfiguration": { "type": "durable-object", "state": "deleted" } },
  "analytics": { "binding": "ANALYTICS_SQL" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api", "/api/*",
      "/", "/admin", "/admin/*", "/login", "/login/*", "/setup", "/setup/*",
      "/monitor/*", "/status/*", "/server/*", "/servers", "/servers/", "/ai", "/ai/",
      "/theme/*", "/polaris-maintenance.js", "/agent/*", "/__scheduled"
    ],
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "vars": { "PBKDF2_ITERATIONS": "3000" }
}
